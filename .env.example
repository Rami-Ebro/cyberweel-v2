# Owner-only admin authentication.
# Copy to .env.local and fill with real values. NEVER commit real secrets.

# The single owner's login email.
ADMIN_OWNER_EMAIL=owner@example.com

# scrypt password hash, format: <salt-hex>:<scrypt-hash-hex> (64-byte scrypt).
# Generate locally:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
ADMIN_OWNER_PASSWORD_HASH=salt-hex:scrypt-hash-hex

# Random session-signing secret, minimum 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value immediately invalidates all existing sessions.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Unified account-session signing secret, required in Development, Preview, and Production.
AUTH_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Shared HMAC secret for privacy-preserving, database-backed rate-limit keys.
# You may omit this when AUTH_SECRET/NEXTAUTH_SECRET is already configured.
RATE_LIMIT_SECRET=change-me-to-a-different-long-random-string

# Keep the bootstrap endpoint disabled after the first owner is created.
ADMIN_SETUP_ENABLED=false
PARTNER_ADMIN_KEY=change-me-to-a-long-random-bootstrap-key

# Primary application database. CyberWeel requires PostgreSQL (for example Neon)
# in Development, Preview, and Production.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional explicit PostgreSQL URL used by migration/deployment scripts.
POSTGRES_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Legacy SQLite source used only by the one-time import tooling. Never assign
# this value to DATABASE_URL.
SQLITE_DATABASE_URL=file:./custom.db

# Vercel Blob read/write token. Configure it for both Production and Preview.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_store_token

# Contact form email delivery via Resend.
# Create an API key in Resend and verify cyberweel.com before using hello@cyberweel.com as sender.
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=hello@cyberweel.com
CONTACT_FROM_EMAIL=CyberWeel <hello@cyberweel.com>

# Gemini powers the authenticated Ambassador Assistant and the public CyberWeel AI Assistant.
# Keep the key server-side and use a Gemini Free Tier project with no billing account linked.
GEMINI_API_KEY=your_google_ai_studio_api_key

# Optional. Defaults to the stable, low-cost gemini-3.5-flash-lite model.
GEMINI_MODEL=gemini-3.5-flash-lite
# The public assistant fails closed unless this acknowledgement is exactly true.
GEMINI_FREE_TIER_ONLY=true
