generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PARTNER
  AMBASSADOR
  CLIENT
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ApplicationType {
  PARTNER
  AMBASSADOR
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CommissionStatus {
  VERIFYING
  ON_HOLD
  NOT_ELIGIBLE
  DUE
  PAID
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

enum ProjectStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectStagePaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum AmbassadorRewardStatus {
  EXPECTED
  EARNED
  PAID
  CANCELLED
}

enum ReferralDecision {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  CONVERTED_TO_CLIENT
  CANCELLED
}

enum ProjectPaymentStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum ReferralStatus {
  NEW
  CONTACTED
  INTERESTED
  AWAITING_RESPONSE
  NOT_INTERESTED
  CONVERTED
}

enum ClientProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ClientInvoiceStatus {
  DRAFT
  DUE
  PAID
  OVERDUE
  CANCELLED
}

enum ClientInvoiceType {
  STANDARD
  RETURN
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  phone                     String?
  name                      String?
  company                   String?
  preferredLanguage         String                     @default("ar")
  clientSource              String?
  internalNotes             String?
  passwordHash              String?
  role                      UserRole                   @default(CLIENT)
  /// Enables client dashboard access when the same auth user also has another role.
  clientEnabled             Boolean                    @default(false)
  isActive                  Boolean                    @default(true)
  partner                   Partner?
  ambassador                Ambassador?
  adminProfile              AdminProfile?
  clientProjects            ClientProject[]
  clientMessages            ClientMessage[]
  clientNotifications       ClientNotification[]
  updatedReferrals          PartnerReferral[]          @relation("ReferralUpdatedBy")
  convertedReferrals        PartnerReferral[]          @relation("ConvertedReferralClient")
  decidedApplications       CollaborationApplication[] @relation("ApplicationDecidedBy")
  adminAuditLogs            AdminAuditLog[]            @relation("AdminAuditActor")
  approvedProjectStages     ProjectStage[]             @relation("ProjectStageApprovedBy")
  ambassadorRewardsAsClient AmbassadorReward[]         @relation("AmbassadorRewardClient")
  passwordResetTokens       PasswordResetToken[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([name])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  action      String
  subjectHash String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([action, subjectHash, windowStart])
  @@index([expiresAt])
}

model AdminProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOwner     Boolean   @default(false)
  isActive    Boolean   @default(true)
  permissions String[]  @default([])
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Partner {
  id                 String                          @id @default(cuid())
  referralNumber     Int                             @unique @default(autoincrement())
  status             PartnerStatus                   @default(PENDING)
  userId             String                          @unique
  user               User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId      String?                         @unique
  application        CollaborationApplication?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  referrals          PartnerReferral[]
  profileCompletedAt DateTime?
  age                Int?
  educationLevel     String?
  educationSpecialty String?
  phone              String?
  specialty          String?
  experience         String?
  availability       String?
  portfolioUrl       String?
  contactMethod      String?
  workTypes          String?
  clientAcquisition  String?
  payoutMethods      String?
  countryRegion      String?
  partnerType        String?
  workAreas          String[]                        @default([])
  supportServices    String[]                        @default([])
  experienceLevel    String?
  experienceYears    Int?
  availabilityType   String?
  weeklyHours        Int?
  cooperationTypes   String[]                        @default([])
  shortBio           String?
  paymentMethods     String[]                        @default([])
  otherPaymentMethod String?
  adminNotes         String?
  decisionNotes      String?
  decidedAt          DateTime?
  assignments        PartnerProject[]
  stageAssignments   ProjectStagePartnerAssignment[]
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@index([status])
}

model Ambassador {
  id                 String             @id @default(cuid())
  referralNumber     Int                @unique @default(autoincrement())
  status             PartnerStatus      @default(PENDING)
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone              String?
  country            String?
  contactMethod      String?
  payoutMethod       String?
  payoutDetails      String?
  profileCompletedAt DateTime?
  age                Int?
  decisionNotes      String?
  decidedAt          DateTime?
  referrals          PartnerReferral[]
  rewards            AmbassadorReward[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
}

model CollaborationApplication {
  id                 String            @id @default(cuid())
  type               ApplicationType
  status             ApplicationStatus @default(PENDING)
  name               String
  email              String
  phone              String?
  age                Int?
  educationLevel     String?
  educationSpecialty String?
  specialty          String?
  market             String?
  details            String?
  countryRegion      String?
  partnerType        String?
  workAreas          String[]          @default([])
  supportServices    String[]          @default([])
  experienceLevel    String?
  experienceYears    Int?
  availabilityType   String?
  weeklyHours        Int?
  cooperationTypes   String[]          @default([])
  shortBio           String?
  paymentMethods     String[]          @default([])
  otherPaymentMethod String?
  decisionNotes      String?
  reviewState        String            @default("NEW")
  decidedById        String?
  decidedBy          User?             @relation("ApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt          DateTime?
  partner            Partner?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([type, status])
  @@index([decidedById])
  @@index([createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  category    String
  entityType  String
  entityId    String?
  entityLabel String?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
}

model AdminNotification {
  id        String    @id @default(cuid())
  title     String
  body      String?
  href      String
  kind      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
  @@index([createdAt])
}

model PartnerProject {
  id              String               @id @default(cuid())
  partnerId       String
  partner         Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  clientProjectId String?
  clientProject   ClientProject?       @relation(fields: [clientProjectId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  tasks           String[]             @default([])
  deliverables    String[]             @default([])
  files           String[]             @default([])
  updates         String[]             @default([])
  status          String               @default("ASSIGNED")
  progress        Int                  @default(0)
  feeAmount       Decimal?             @db.Decimal(12, 2)
  feeCurrency     String               @default("USD")
  paymentStatus   ProjectPaymentStatus @default(PENDING)
  paidAt          DateTime?
  dueAt           DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([partnerId, clientProjectId])
  @@index([partnerId, status])
  @@index([clientProjectId])
}

model PartnerReferral {
  id                   String             @id @default(cuid())
  partnerId            String?
  partner              Partner?           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  ambassadorId         String?
  ambassador           Ambassador?        @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)
  name                 String?
  email                String?
  phone                 String?
  company              String?
  status               ReferralStatus     @default(NEW)
  sourcePath           String?
  source               String?
  contactMethod        String?
  adminDecision        ReferralDecision?
  adminNotes           String?
  commissionType       CommissionType?
  commissionAmount     Decimal?           @db.Decimal(12, 2)
  commissionRate       Decimal?           @db.Decimal(5, 2)
  commissionBaseAmount Decimal?           @db.Decimal(12, 2)
  commissionCurrency   String             @default("USD")
  commissionStatus     CommissionStatus   @default(VERIFYING)
  updatedById          String?
  updatedBy            User?              @relation("ReferralUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  notes                String?
  clientProject        ClientProject?
  ambassadorRewards    AmbassadorReward[]
  convertedClientId    String?
  convertedClient      User?              @relation("ConvertedReferralClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([partnerId])
  @@index([partnerId, status])
  @@index([ambassadorId, status])
  @@index([updatedById])
  @@index([convertedClientId])
  @@index([createdAt])
}

model ClientProject {
  id                    String              @id @default(cuid())
  clientId              String
  client                User                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  referralId            String?             @unique
  referral              PartnerReferral?    @relation(fields: [referralId], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  agreementDetails      String?
  financialPlan         String?
  currency              String              @default("USD")
  stages                String?
  ambassadorRewardRate  Decimal?            @db.Decimal(5, 2)
  ambassadorQualifiedAt DateTime?
  links                 String[]            @default([])
  notes                 String?
  status                ClientProjectStatus @default(PLANNING)
  progress              Int                 @default(0)
  startsAt              DateTime?
  dueAt                 DateTime?
  files                 ClientFile[]
  submissions           ClientSubmission[]
  invoices              ClientInvoice[]
  projectStages         ProjectStage[]
  ambassadorRewards     AmbassadorReward[]
  messages              ClientMessage[]
  partnerAssignments    PartnerProject[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([clientId])
  @@index([clientId, status])
}

model AmbassadorRewardLevel {
  id                     String   @id @default(cuid())
  name                   String
  minSuccessfulReferrals Int      @unique
  rate                   Decimal  @db.Decimal(5, 2)
  isActive               Boolean  @default(true)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([isActive, minSuccessfulReferrals])
}

model ProjectStage {
  id                 String                          @id @default(cuid())
  projectId          String
  project            ClientProject                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  amount             Decimal                         @db.Decimal(12, 2)
  currency           String                          @default("USD")
  status             ProjectStageStatus              @default(NOT_STARTED)
  paymentStatus      ProjectStagePaymentStatus       @default(PENDING)
  startsAt           DateTime?
  completedAt        DateTime?
  paidAt             DateTime?
  approvedAt         DateTime?
  approvedById       String?
  approvedBy         User?                           @relation("ProjectStageApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rewards            AmbassadorReward[]
  partnerAssignments ProjectStagePartnerAssignment[]
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@index([projectId, status])
  @@index([paymentStatus])
}

model ProjectStagePartnerAssignment {
  id             String               @id
  projectStageId String
  projectStage   ProjectStage         @relation(fields: [projectStageId], references: [id], onDelete: Cascade)
  partnerId      String
  partner        Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tasks          String[]             @default([])
  deliverables   String[]             @default([])
  status         String               @default("ASSIGNED")
  progress       Int                  @default(0)
  feeAmount      Decimal?             @db.Decimal(12, 2)
  feeCurrency    String               @default("USD")
  paymentStatus  ProjectPaymentStatus @default(PENDING)
  paidAt         DateTime?
  dueAt          DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now())

  @@unique([partnerId, projectStageId])
  @@index([projectStageId])
  @@index([partnerId, status])
  @@index([paymentStatus])
}

model AmbassadorReward {
  id             String                 @id @default(cuid())
  ambassadorId   String
  ambassador     Ambassador             @relation(fields: [ambassadorId], references: [id], onDelete: Restrict)
  referralId     String
  referral       PartnerReferral        @relation(fields: [referralId], references: [id], onDelete: Restrict)
  clientId       String
  client         User                   @relation("AmbassadorRewardClient", fields: [clientId], references: [id], onDelete: Restrict)
  projectId      String
  project        ClientProject          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectStageId String
  projectStage   ProjectStage           @relation(fields: [projectStageId], references: [id], onDelete: Restrict)
  rate           Decimal                @db.Decimal(5, 2)
  baseAmount     Decimal                @db.Decimal(12, 2)
  amount         Decimal                @db.Decimal(12, 2)
  currency       String                 @default("USD")
  status         AmbassadorRewardStatus @default(EXPECTED)
  earnedAt       DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  adminNotes     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([ambassadorId, projectStageId])
  @@index([ambassadorId, status])
  @@index([projectId])
  @@index([referralId])
  @@index([clientId])
  @@index([status, createdAt])
}

model ClientFile {
  id              String            @id @default(cuid())
  projectId       String
  project         ClientProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissionId    String?
  submission      ClientSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  name            String
  url             String
  kind            String?
  size            Int?
  storageProvider String?
  source          String            @default("ADMIN")
  createdAt       DateTime          @default(now())

  @@index([projectId])
  @@index([submissionId])
  @@index([source])
}

model ClientSubmission {
  id        String        @id @default(cuid())
  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  note      String?
  links     String[]      @default([])
  status    String        @default("UPLOADING")
  files     ClientFile[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([projectId, createdAt])
  @@index([status])
}

model ClientInvoice {
  id        String              @id @default(cuid())
  projectId String
  project   ClientProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    String              @unique
  type      ClientInvoiceType   @default(STANDARD)
  amount    Decimal             @db.Decimal(12, 2)
  currency  String              @default("USD")
  status    ClientInvoiceStatus @default(DRAFT)
  dueAt     DateTime?
  paidAt    DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([projectId])
  @@index([type])
  @@index([status])
}

model InvoiceSequence {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model ClientMessage {
  id        String         @id @default(cuid())
  clientId  String
  client    User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   ClientProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject   String?
  body      String
  fromAdmin Boolean        @default(false)
  readAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([clientId])
  @@index([clientId, readAt])
  @@index([projectId])
}

model ClientNotification {
  id        String    @id @default(cuid())
  clientId  String
  client    User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  section   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, readAt])
  @@index([clientId, createdAt])
}

model SmartLink {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  destinationUrl String
  isActive       Boolean         @default(true)
  redirectType   String          @default("TEMPORARY")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  scans          SmartLinkScan[]
}

model SmartLinkScan {
  id          String    @id @default(cuid())
  smartLinkId String
  link        SmartLink @relation(fields: [smartLinkId], references: [id], onDelete: Cascade)
  scannedAt   DateTime  @default(now())
  ipHash      String?
  country     String?
  city        String?
  device      String?
  os          String?
  browser     String?
  userAgent   String?
  referer     String?
  createdAt   DateTime  @default(now())

  @@index([smartLinkId])
  @@index([scannedAt])
}
