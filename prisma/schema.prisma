generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PARTNER
  CLIENT
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ReferralStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  REJECTED
}

enum ClientProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
}

enum ClientInvoiceStatus {
  DRAFT
  DUE
  PAID
  OVERDUE
  CANCELLED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  passwordHash        String?
  role                UserRole             @default(CLIENT)
  partner             Partner?
  clientProjects      ClientProject[]
  clientMessages      ClientMessage[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Partner {
  id             String            @id @default(cuid())
  referralNumber Int               @unique @default(autoincrement())
  status         PartnerStatus     @default(PENDING)
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals      PartnerReferral[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
}

model PartnerReferral {
  id          String         @id @default(cuid())
  partnerId   String
  partner     Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name        String?
  email       String?
  phone       String?
  status      ReferralStatus @default(NEW)
  sourcePath  String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([partnerId])
  @@index([partnerId, status])
  @@index([createdAt])
}

model ClientProject {
  id          String               @id @default(cuid())
  clientId    String
  client      User                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      ClientProjectStatus  @default(PLANNING)
  progress    Int                  @default(0)
  startsAt    DateTime?
  dueAt       DateTime?
  files       ClientFile[]
  invoices    ClientInvoice[]
  messages    ClientMessage[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([clientId])
  @@index([clientId, status])
}

model ClientFile {
  id        String        @id @default(cuid())
  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  url       String
  kind      String?
  size      Int?
  createdAt DateTime      @default(now())

  @@index([projectId])
}

model ClientInvoice {
  id        String              @id @default(cuid())
  projectId String
  project   ClientProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    String              @unique
  amount    Decimal             @db.Decimal(12, 2)
  currency  String              @default("USD")
  status    ClientInvoiceStatus @default(DRAFT)
  dueAt     DateTime?
  paidAt    DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([projectId])
  @@index([status])
}

model ClientMessage {
  id        String         @id @default(cuid())
  clientId  String
  client    User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   ClientProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject   String?
  body      String
  fromAdmin Boolean        @default(false)
  readAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([clientId])
  @@index([clientId, readAt])
  @@index([projectId])
}

model SmartLink {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  destinationUrl String
  isActive       Boolean         @default(true)
  redirectType   String          @default("TEMPORARY")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  scans          SmartLinkScan[]
}

model SmartLinkScan {
  id          String    @id @default(cuid())
  smartLinkId String
  link        SmartLink @relation(fields: [smartLinkId], references: [id], onDelete: Cascade)
  scannedAt   DateTime  @default(now())
  ipHash      String?
  country     String?
  city        String?
  device      String?
  os          String?
  browser     String?
  userAgent   String?
  referer     String?
  createdAt   DateTime  @default(now())

  @@index([smartLinkId])
  @@index([scannedAt])
}